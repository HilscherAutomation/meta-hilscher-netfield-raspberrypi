From 6b64d0491601cb71a215d158120c1b50b9bb2a90 Mon Sep 17 00:00:00 2001
From: netX System <github@hilscher.com>
Date: Tue, 5 Dec 2017 11:22:44 +0100
Subject: [PATCH] Added initial nxpi overlays

---
 arch/arm/boot/dts/overlays/nxpi_rs232.dts | 41 +++++++++++++++++++++++++++++++
 arch/arm/boot/dts/overlays/nxpi_rs485.dts | 41 +++++++++++++++++++++++++++++++
 2 files changed, 82 insertions(+)
 create mode 100644 arch/arm/boot/dts/overlays/nxpi_rs232.dts
 create mode 100644 arch/arm/boot/dts/overlays/nxpi_rs485.dts

diff --git a/arch/arm/boot/dts/overlays/nxpi_rs232.dts b/arch/arm/boot/dts/overlays/nxpi_rs232.dts
new file mode 100644
index 0000000..d82225f
--- /dev/null
+++ b/arch/arm/boot/dts/overlays/nxpi_rs232.dts
@@ -0,0 +1,41 @@
+/dts-v1/;
+/plugin/;
+
+/{
+	compatible = "brcm,bcm2708";
+
+	fragment@0 {
+		target = <&uart1>;
+		__overlay__ {
+			pinctrl-names = "default";
+			pinctrl-0 = <&uart1_pins>;
+			status = "okay";
+			interrupts = <1 29>;
+			interrupt-parent = <&intc>;
+			autoload = "okay";
+		};
+	};
+
+	fragment@1 {
+		target = <&gpio>;
+		__overlay__ {
+			uart1_pins: uart1_pins {
+				brcm,pins = <14 15>;
+				brcm,function = <2>; /* alt5 */
+				brcm,pull = <0 2>;
+			};
+		};
+	};
+
+	fragment@2 {
+		target-path = "/chosen";
+		__overlay__ {
+			bootargs = "8250.nr_uarts=1";
+		};
+	};
+
+	__overrides__ {
+		txd1_pin = <&uart1_pins>,"brcm,pins:0";
+		rxd1_pin = <&uart1_pins>,"brcm,pins:4";
+	};
+};
diff --git a/arch/arm/boot/dts/overlays/nxpi_rs485.dts b/arch/arm/boot/dts/overlays/nxpi_rs485.dts
new file mode 100644
index 0000000..d82225f
